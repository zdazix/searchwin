{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai-check.js": {
      "maxDuration": 300
    },
    "api/ai-check-worker.js": {
      "maxDuration": 300
    },
    "api/admin.js": {
      "maxDuration": 300
    },
    "api/cron.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/api/_lib/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai-check/:path*",
      "destination": "/api/ai-check?path=:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?path=:path*"
    },
    {
      "source": "/ai-check/r/:id",
      "destination": "/ai-check/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ai-check/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "17 4 * * *"
    }
  ]
}
