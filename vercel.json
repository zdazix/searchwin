{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai-check/*.js": {
      "maxDuration": 150
    }
  },
  "redirects": [
    {
      "source": "/api/_lib/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
