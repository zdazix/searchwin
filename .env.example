# Free AI check (/ai-check). Set these in Vercel → Project → Settings → Environment Variables.
# Secrets (no PUBLIC_ prefix) live only in the functions and never reach the browser.

# Database: added automatically by the Neon integration (Vercel Marketplace). Only the leads table.
DATABASE_URL=

# DataForSEO API access (dataforseo.com → API Access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Claude API key (console.anthropic.com), reads the client's website
ANTHROPIC_API_KEY=
# Optional: model for reading websites
ANTHROPIC_MODEL=claude-haiku-5-5

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → widget in "Invisible" mode for searchwin.ai)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the 5-minute ticket that lets the page ask ChatGPT after the site is read. Random: openssl rand -hex 32
CHECK_TICKET_SECRET=

# Meta Pixel ID (Events Manager). Browser events only at this stage.
PUBLIC_META_PIXEL_ID=

# Google Ads: AW-XXXXXXXXX and the label of each conversion action (Goals → Conversions → Tag setup)
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GADS_LABEL_CHECK_COMPLETED=
PUBLIC_GADS_LABEL_AUDIT_REQUESTED=
# GA4 measurement ID, G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Optional: Telegram message for every audit request and a broken DataForSEO key.
# Bot from @BotFather, chat id from @userinfobot (or a group id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
