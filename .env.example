# Free AI check (/ai-check). Set these in Vercel → Project → Settings → Environment Variables.
# Secrets (no PUBLIC_ prefix) live only in the functions and never reach the browser.

# Database: added automatically by the Neon integration (Vercel Marketplace)
DATABASE_URL=

# DataForSEO API access (dataforseo.com → API Access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Claude API key (console.anthropic.com), reads the client's website
ANTHROPIC_API_KEY=
# Optional: model for reading websites
ANTHROPIC_MODEL=claude-haiku-5-5

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → widget in "Invisible" mode for searchwin.ai)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta: Events Manager → your pixel → Settings → Conversions API → Generate access token
PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: test code from Events Manager → Test events (remove after testing)
META_TEST_EVENT_CODE=
# Optional: Graph API version
META_GRAPH_API_VERSION=v23.0

# Google Ads: AW-XXXXXXXXX and the label of each conversion action (Goals → Conversions → Tag setup)
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GADS_LABEL_CHECK_STARTED=
PUBLIC_GADS_LABEL_CHECK_COMPLETED=
PUBLIC_GADS_LABEL_AUDIT_REQUESTED=
# GA4 measurement ID, G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Admin at /admin/
ADMIN_PASSWORD=
# Random, 32+ characters: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Random strings: openssl rand -hex 32
INTERNAL_JOB_SECRET=
IP_HASH_SALT=
CRON_SECRET=

# Telegram alerts: bot from @BotFather, chat id from @userinfobot (or a group id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Links in the admin and Telegram messages
PUBLIC_BASE_URL=https://searchwin.ai

# Limits (defaults shown)
AI_CHECK_DAILY_BUDGET_USD=20
AI_CHECK_IP_DAILY_LIMIT=5
